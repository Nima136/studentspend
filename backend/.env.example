# TiDB Cloud / MySQL-compatible database
DB_HOST=your-tidb-host
DB_USER=your-tidb-user
DB_PASSWORD=your-tidb-password
DB_NAME=studentspend
DB_PORT=4000

# Long random secret used to sign JWT sessions
JWT_SECRET=change_this_to_a_long_random_secret

# Render supplies PORT automatically; keep this for local development
PORT=3000

# Optional: lock API CORS to your deployed frontend
FRONTEND_ORIGIN=https://your-frontend.onrender.com

# Optional: temporarily enable /debug-db while troubleshooting
DEBUG_DB=false
